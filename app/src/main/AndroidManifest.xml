<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Dictée : demandé au premier appui sur le micro, jamais au démarrage.
         L'enregistrement vit dans le cache le temps d'être transcrit, puis est
         effacé. Un appareil sans micro garde l'app entièrement utilisable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- Poste SIP : la conversation doit survivre à l'écran éteint et au
         passage dans une autre app, donc l'appel tient un service au premier
         plan. Le type « microphone » est celui qui correspond : l'app capte le
         micro en arrière-plan. Le type « phoneCall » exigerait MANAGE_OWN_CALLS
         et une intégration au journal d'appels du système, qu'on ne veut pas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- Discover UnifiedPush distributors (ntfy, etc.) on Android 11+. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER"/>
        </intent>
    </queries>

    <application
        android:name=".BfSmsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BfSms"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BfSms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Un numéro tapé ailleurs — lien tel: d'une page web, fiche de
                 contact, bouton « appeler » d'une autre app — peut être composé
                 ici : l'app devient un choix possible dans le sélecteur.
                 ⚠️ ACTION_DIAL et ACTION_VIEW, jamais ACTION_CALL : composer
                 sans que personne ne relise le numéro exigerait CALL_PHONE, et
                 l'appel part de toute façon par le PBX, pas par la carte SIM.
                 Devenir le téléphone PAR DÉFAUT est autre chose encore — il
                 faudrait un InCallService qui prenne en charge les appels
                 cellulaires, ce que ce poste SIP ne fait pas. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <!-- « Composer » sans numéro : un raccourci, ou l'assistant. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

            <!-- Web-login capture deep link: com.bluefoxconsultant.sms://auth?code=&state= -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="com.bluefoxconsultant.sms"
                    android:host="auth"/>
            </intent-filter>
        </activity>

        <!-- Hands a downloaded attachment to the app that can open it, without
             ever writing to shared storage. Authority is package-scoped so a
             branded flavour doesn't collide with this build. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- UnifiedPush: receives endpoint + push messages from the distributor. -->
        <receiver
            android:name=".push.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE"/>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT"/>
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED"/>
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED"/>
            </intent-filter>
        </receiver>

        <!-- Notification quick-reply (RemoteInput → POST /send). -->
        <receiver
            android:name=".push.ReplyReceiver"
            android:exported="false"/>

        <!-- Swipe-away → POST /mark_read (read sync). -->
        <receiver
            android:name=".push.MarkReadReceiver"
            android:exported="false"/>

        <!-- Mail: notification quick-reply (RemoteInput → POST /reply). -->
        <receiver
            android:name=".push.MailReplyReceiver"
            android:exported="false"/>

        <!-- Mail: swipe-away → POST /mark_read. -->
        <receiver
            android:name=".push.MailMarkReadReceiver"
            android:exported="false"/>


        <service
            android:name=".sip.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- GenFox comme assistant du système. Les trois pièces sont
             indissociables : le service d'interaction déclare la capacité, le
             service de session ouvre l'app au geste d'assistance, et le service
             de reconnaissance n'existe que parce que la déclaration l'exige —
             sans lui, l'app n'apparaît pas dans le sélecteur, en silence.
             BIND_VOICE_INTERACTION garantit que seul le système peut s'y lier. -->
        <service
            android:name=".assist.AssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service"/>
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService"/>
            </intent-filter>
        </service>

        <service
            android:name=".assist.AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService"/>
            </intent-filter>
        </service>

        <service
            android:name=".assist.AssistRecognitionService"
            android:exported="true"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService"/>
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/assist_recognition"/>
        </service>

    </application>

</manifest>
